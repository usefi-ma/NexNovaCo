@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<MudThemeProvider Theme="DashboardTheme.Light" IsDarkMode="false" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
<MudLayout Class="dashboard-shell">
    <a class="dashboard-skip-link" href="#dashboard-content">Skip to dashboard content</a>
    <MudAppBar Elevation="0" Class="dashboard-appbar">
        <MudIconButton @ref="_toggleButton" Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Toggle navigation" aria-controls="dashboard-navigation" aria-expanded="@_drawerOpen.ToString().ToLowerInvariant()" />
        <MudText Typo="Typo.body2" Class="dashboard-appbar-title">NexNovaCo <span class="dashboard-muted">/ @_pageTitle</span></MudText>
        <MudSpacer />
        <MudButton OnClick="OpenPublicSite" StartIcon="@Icons.Material.Outlined.OpenInNew" Class="d-none d-sm-inline-flex mr-3" Color="Color.Inherit">View website</MudButton>
        <DashboardUserMenu />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Never" Elevation="0" Class="dashboard-drawer" id="dashboard-navigation" inert="@(!_drawerOpen)">
        <MudFocusTrap Disabled="@(!_drawerOpen || !_compact)" DefaultFocus="DefaultFocus.FirstChild" Class="dashboard-drawer-focus">
        <div class="dashboard-drawer-body" @onkeydown="HandleDrawerKeyAsync">
        <MudDrawerHeader Class="dashboard-brand">
            <img src="image/logo.png" alt="" width="36" height="30" />
            <div><MudText Typo="Typo.h6">NexNovaCo</MudText><MudText Typo="Typo.caption" Class="dashboard-muted">CONTENT MANAGEMENT</MudText></div>
        </MudDrawerHeader>
        <nav aria-label="Dashboard" class="dashboard-nav">
            <MudNavMenu Color="Color.Primary">
                <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SpaceDashboard">Dashboard</MudNavLink>
                <MudText Typo="Typo.overline" Class="dashboard-nav-label">Content</MudText>
                <MudNavGroup Title="Home" Icon="@Icons.Material.Outlined.Web" @bind-Expanded="_homeExpanded">
                    <MudNavLink Href="/dashboard/content/home/hero" Match="NavLinkMatch.All">Hero</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/welcome" Match="NavLinkMatch.All">Welcome</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/services" Match="NavLinkMatch.All">Services Section</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/projects" Match="NavLinkMatch.All">Projects Section</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/team" Match="NavLinkMatch.All">Team Section</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/statistics" Match="NavLinkMatch.All">Statistics</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/partners" Match="NavLinkMatch.All">Partners Section</MudNavLink>
                    <MudNavLink Href="/dashboard/content/home/testimonials" Match="NavLinkMatch.All">Testimonials Section</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="About" Icon="@Icons.Material.Outlined.Info" @bind-Expanded="_aboutExpanded">
                    <MudNavLink Href="/dashboard/content/about/hero" Match="NavLinkMatch.Prefix">Hero</MudNavLink>
                    <MudNavLink Href="/dashboard/content/about/story" Match="NavLinkMatch.Prefix">Story</MudNavLink>
                    <MudNavLink Href="/dashboard/content/about/vision" Match="NavLinkMatch.Prefix">Vision</MudNavLink>
                    <MudNavLink Href="/dashboard/content/about/timeline" Match="NavLinkMatch.Prefix">Timeline</MudNavLink>
                    <MudNavLink Href="/dashboard/content/about/mission" Match="NavLinkMatch.Prefix">Mission</MudNavLink>
                    <MudNavLink Href="/dashboard/content/about/partners" Match="NavLinkMatch.Prefix">Partners</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Services" Icon="@Icons.Material.Outlined.DesignServices" @bind-Expanded="_servicesExpanded">
                    <MudNavLink Href="/dashboard/content/services/hero" Match="NavLinkMatch.Prefix">Hero</MudNavLink>
                    <MudNavLink Href="/dashboard/content/services/overview" Match="NavLinkMatch.Prefix">Services Section</MudNavLink>
                    <MudNavLink Href="/dashboard/content/services/benefits" Match="NavLinkMatch.Prefix">Benefits</MudNavLink>
                    <MudNavLink Href="/dashboard/content/services/process" Match="NavLinkMatch.Prefix">Process</MudNavLink>
                    <MudNavLink Href="/dashboard/content/services/pricing" Match="NavLinkMatch.Prefix">Pricing</MudNavLink>
                    <MudNavLink Href="/dashboard/content/services/faq" Match="NavLinkMatch.Prefix">FAQ</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Projects" Icon="@Icons.Material.Outlined.WorkOutline" @bind-Expanded="_projectsExpanded">
                    <MudNavLink Href="/dashboard/content/projects/hero" Match="NavLinkMatch.All">Hero</MudNavLink>
                    <MudNavLink Href="/dashboard/content/projects/overview" Match="NavLinkMatch.All">Projects Section</MudNavLink>
                    <MudNavLink Href="/dashboard/content/projects/testimonials" Match="NavLinkMatch.All">Testimonials Section</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Team" Icon="@Icons.Material.Outlined.Groups" @bind-Expanded="_teamExpanded">
                    <MudNavLink Href="/dashboard/content/team/hero" Match="NavLinkMatch.All">Hero</MudNavLink>
                    <MudNavLink Href="/dashboard/content/team/overview" Match="NavLinkMatch.All">Team Section</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Contact" Icon="@Icons.Material.Outlined.ContactMail" @bind-Expanded="_contactExpanded">
                    <MudNavLink Href="/dashboard/content/contact/hero" Match="NavLinkMatch.All">Hero</MudNavLink>
                    <MudNavLink Href="/dashboard/content/contact/info" Match="NavLinkMatch.All">Contact Info</MudNavLink>
                    <MudNavLink Href="/dashboard/content/contact/form" Match="NavLinkMatch.All">Form</MudNavLink>
                    <MudNavLink Href="/dashboard/content/contact/map" Match="NavLinkMatch.All">Map</MudNavLink>
                </MudNavGroup>
                <MudText Typo="Typo.overline" Class="dashboard-nav-label">Shared Content</MudText>
                <MudNavLink Href="/dashboard/content/testimonials" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.FormatQuote">Testimonials</MudNavLink>
                <MudNavLink Href="/dashboard/content/partners" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Handshake">Partners</MudNavLink>
                <MudNavLink Href="/dashboard/content/shared-team" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Groups">Team Members</MudNavLink>
                <MudNavLink Href="/dashboard/content/shared-projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.WorkOutline">Projects</MudNavLink>
                <MudNavLink Href="/dashboard/content/shared-services" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.DesignServices">Services</MudNavLink>
            </MudNavMenu>
        </nav>
        <div class="dashboard-drawer-note"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" /><span>Administrator workspace</span></div>
        </div>
        </MudFocusTrap>
    </MudDrawer>
    <MudMainContent Class="dashboard-main">
        <main id="dashboard-content" tabindex="-1"><MudContainer MaxWidth="MaxWidth.Large" Class="dashboard-container">@Body</MudContainer></main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _compact;
    private bool _homeExpanded;
    private bool _aboutExpanded;
    private bool _servicesExpanded;
    private bool _projectsExpanded;
    private bool _teamExpanded;
    private bool _contactExpanded;
    private MudIconButton? _toggleButton;
    private string _pageTitle = "Dashboard";
    protected override void OnInitialized()
    {
        UpdateTitle();
        Navigation.LocationChanged += OnLocationChanged;
    }
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void OnBreakpointChanged(Breakpoint breakpoint) => _compact = breakpoint < Breakpoint.Md;
    private async Task HandleDrawerKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !_compact) return;
        _drawerOpen = false;
        if (_toggleButton is not null) await _toggleButton.FocusAsync();
    }
    private void UpdateTitle()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isHome = path.StartsWith("dashboard/content/home", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("dashboard/home/hero", StringComparison.OrdinalIgnoreCase);
        if (isHome) _homeExpanded = true;
        var isAbout = path.StartsWith("dashboard/content/about", StringComparison.OrdinalIgnoreCase);
        if (isAbout) _aboutExpanded = true;
        var isServices = path.StartsWith("dashboard/content/services", StringComparison.OrdinalIgnoreCase);
        if (isServices) _servicesExpanded = true;
        var isProjects = path.StartsWith("dashboard/content/projects", StringComparison.OrdinalIgnoreCase);
        if (isProjects) _projectsExpanded = true;
        var isTeam = path.StartsWith("dashboard/content/team", StringComparison.OrdinalIgnoreCase);
        if (isTeam) _teamExpanded = true;
        var isContact = path.StartsWith("dashboard/content/contact", StringComparison.OrdinalIgnoreCase);
        if (isContact) _contactExpanded = true;
        _pageTitle = isContact ? "Contact / " + ContactSectionName(path) : isTeam ? "Team / " + TeamSectionName(path) : isProjects ? "Projects / " + ProjectsSectionName(path) : isServices ? "Services / " + ServicesSectionName(path) : isAbout ? "About / " + AboutSectionName(path)
            : path.StartsWith("dashboard/content/testimonials", StringComparison.OrdinalIgnoreCase) ? "Shared Content / Testimonials"
            : path.StartsWith("dashboard/content/partners", StringComparison.OrdinalIgnoreCase) ? "Shared Content / Partners"
            : path.StartsWith("dashboard/content/shared-services/home-featured", StringComparison.OrdinalIgnoreCase) ? "Services / Home Featured"
            : path.StartsWith("dashboard/content/shared-services", StringComparison.OrdinalIgnoreCase) ? "Shared Content / Services"
            : path.StartsWith("dashboard/content/shared-projects/home-featured", StringComparison.OrdinalIgnoreCase) ? "Projects / Home Featured"
            : path.StartsWith("dashboard/content/shared-projects", StringComparison.OrdinalIgnoreCase) ? "Shared Content / Projects"
            : path.StartsWith("dashboard/content/shared-team/home-featured", StringComparison.OrdinalIgnoreCase) ? "Team Members / Home Featured"
            : path.StartsWith("dashboard/content/shared-team", StringComparison.OrdinalIgnoreCase) ? "Shared Content / Team Members"
            : !isHome ? "Dashboard"
            : path.StartsWith("dashboard/content/home/testimonials", StringComparison.OrdinalIgnoreCase) ? "Home / Testimonials"
            : path.StartsWith("dashboard/content/home/partners", StringComparison.OrdinalIgnoreCase) ? "Home / Partners"
            : path.StartsWith("dashboard/content/home/statistics", StringComparison.OrdinalIgnoreCase) ? "Home / Statistics"
            : path.StartsWith("dashboard/content/home/team", StringComparison.OrdinalIgnoreCase) ? "Home / Team"
            : path.StartsWith("dashboard/content/home/projects", StringComparison.OrdinalIgnoreCase) ? "Home / Projects"
            : path.StartsWith("dashboard/content/home/services", StringComparison.OrdinalIgnoreCase) ? "Home / Services"
            : path.StartsWith("dashboard/content/home/welcome", StringComparison.OrdinalIgnoreCase) ? "Home / Welcome" : "Home / Hero";
    }
    private static string ContactSectionName(string path) => path.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(3)?.ToLowerInvariant() switch
    {
        "info" => "Contact Info", "form" => "Form", "map" => "Map", _ => "Hero"
    };
    private static string TeamSectionName(string path) => path.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(3)?.ToLowerInvariant() == "overview" ? "Team Section" : "Hero";
    private static string ProjectsSectionName(string path) => path.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(3)?.ToLowerInvariant() switch
    {
        "overview" => "Projects Section", "testimonials" => "Testimonials Section", _ => "Hero"
    };
    private static string ServicesSectionName(string path) => path.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(3)?.ToLowerInvariant() switch
    {
        "overview" => "Services Section", "benefits" => "Benefits", "process" => "Process", "pricing" => "Pricing", "faq" => "FAQ", _ => "Hero"
    };
    private static string AboutSectionName(string path) => path.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(3)?.ToLowerInvariant() switch
    {
        "story" => "Story", "vision" => "Vision", "timeline" => "Timeline", "mission" => "Mission", "partners" => "Partners", _ => "Hero"
    };
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() => { UpdateTitle(); if (_compact) _drawerOpen = false; StateHasChanged(); });
    private void OpenPublicSite() => Navigation.NavigateTo("/", forceLoad: true);
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
