@inherits LayoutComponentBase

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGlobalSettingsService GlobalSettings
@inject INavigationContentService NavigationContent

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content">Skip to content</a>
<SiteHeader Identity="_identity" Items="_navigation" />
<main id="main-content" tabindex="-1">
    @Body
</main>
<SiteFooter Identity="_identity" Items="_navigation" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private IJSObjectReference? _shellModule;
    private SiteIdentityEditModel _identity = SiteIdentityEditModel.Approved();
    private IReadOnlyList<NavigationListItem> _navigation = GlobalSiteDefaults.Navigation;
    protected override async Task OnInitializedAsync()
    {
        _identity = await GlobalSettings.ReadSiteIdentityAsync();
        _navigation = await NavigationContent.GetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _shellModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/public-shell.js");
            await _shellModule.InvokeVoidAsync("initialize");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_shellModule is null) return;
        try
        {
            await _shellModule.InvokeVoidAsync("dispose");
            await _shellModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* The Interactive Server circuit has ended. */ }
    }
}
