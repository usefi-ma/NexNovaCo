@* Shared link order and clean routes for both header and footer. *@
<ul id="@Id">
    <li><NavLink href="" Match="NavLinkMatch.All" @onclick="OnNavigate">Home</NavLink></li>
    <li><NavLink href="about" @onclick="OnNavigate">About</NavLink></li>
    <li><NavLink href="services" @onclick="OnNavigate">Services</NavLink></li>
    <li><NavLink href="projects" @onclick="OnNavigate">Projects</NavLink></li>
    <li><NavLink href="team" @onclick="OnNavigate">Team</NavLink></li>
    <li><NavLink href="contact" @onclick="OnNavigate">Contact</NavLink></li>
</ul>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnNavigate { get; set; }
}
