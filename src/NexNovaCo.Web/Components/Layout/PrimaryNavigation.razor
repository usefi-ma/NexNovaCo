@* Shared link order and clean routes for both header and footer. *@
<ul id="@Id">
    @foreach (var item in Items)
    {
        <li @key="item.Id"><NavLink href="@(item.Url == "/" ? "" : item.Url)" Match="@(item.Url == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="OnNavigate">@item.Label</NavLink></li>
    }
</ul>

@code {
    [Parameter] public IReadOnlyList<NavigationListItem> Items { get; set; } = GlobalSiteDefaults.Navigation;
    [Parameter] public string? Id { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnNavigate { get; set; }
}
