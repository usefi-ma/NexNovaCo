@page "/about"
@inject IAboutContentService ContentService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>About | NexNovaCo</PageTitle>
<HeadContent>
    <meta name="description" content="Learn about NexNovaCo's story, mission, vision, and approach to software and AI solutions." />
    <link rel="stylesheet" href="@Assets["css/about.css"]" />
    <link rel="stylesheet" href="@Assets["css/inner-page-blazor.css"]" />
    <link rel="stylesheet" href="@Assets["css/carousel-blazor.css"]" />
    <link rel="stylesheet" href="@Assets["css/about-blazor.css"]" />
</HeadContent>

@if (_content is not null)
{
    <div class="about-page" @ref="_root" style="--about-hero-image: url('@Navigation.ToAbsoluteUri(_content.HeroImagePath)')">
        <InnerPageHero Content="_content.Hero" />
        <AboutStorySection Content="_content.Story" />
        <AboutVisionSection Content="_content.Vision" />
        <AboutTimelineSection Content="_content.Timeline" />
        <AboutMissionSection Content="_content.Mission" />
        @if (_content.Partners.Count > 0)
        {
            <PartnersSection Heading="_content.PartnersHeading" Items="_content.Partners" />
        }
    </div>
}

@code {
    private AboutContent? _content;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _initialized;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        try { _content = await ContentService.GetAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_content is null || _initialized || _disposed) return;
        _initialized = true;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/about.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }
        _module = module;
        await _module.InvokeVoidAsync("initialize", _root);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        // MutationObserver owns DOM cleanup; no late interop into a detached subtree.
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
