@page "/dashboard/settings/footer"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IGlobalSettingsService GlobalSettings
@inject NavigationManager Navigation
@inject ILogger<GlobalFooterEditor> Logger

<PageTitle>Footer | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Global Settings / Footer</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Footer</MudText>
<MudText Class="dashboard-muted mb-7">Edit the existing Footer text and newsletter presentation. Newsletter signup stays unavailable; these settings cannot activate subscriptions.</MudText>
<UnsavedChangesGuard IsDirty="IsDirty" />
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error</MudAlert> }
@if (_saved) { <MudAlert Severity="Severity.Success" role="status" Class="mb-4">Footer saved.</MudAlert> }
@if (_model is not null)
{
    <MudPaper Class="dashboard-editor" Elevation="0" Outlined="true">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="ClearSaved" FormName="global-footer">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <section class="dashboard-editor-section" aria-label="Footer content">
                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Description" HelperText="Required; plain text, up to 1000 characters." Variant="Variant.Outlined" MaxLength="1000" Lines="3" Sizing="InputSizing.Auto" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.Copyright" For="@(() => _model.Copyright)" Label="Copyright" HelperText="Required; up to 200 characters." Variant="Variant.Outlined" MaxLength="200" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudCheckBox T="bool" @bind-Value="_model.NewsletterVisible" Label="Show unavailable newsletter section" Disabled="_saving" />
                <MudTextField @bind-Value="_model.NewsletterHeading" For="@(() => _model.NewsletterHeading)" Label="Newsletter heading" HelperText="Required; up to 120 characters." Variant="Variant.Outlined" MaxLength="120" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.NewsletterPlaceholder" For="@(() => _model.NewsletterPlaceholder)" Label="Newsletter placeholder" HelperText="Required; up to 160 characters." Variant="Variant.Outlined" MaxLength="160" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.NewsletterSubmitLabel" For="@(() => _model.NewsletterSubmitLabel)" Label="Newsletter button text" HelperText="Required; this button always remains disabled." Variant="Variant.Outlined" MaxLength="60" Immediate="true" Disabled="_saving" Class="mb-5" />
            </section>
            <MudDivider />
            <div class="dashboard-editor-actions">
                <MudText Typo="Typo.caption" Class="dashboard-muted">Changes go live on the public site when saved.</MudText>
                <MudStack Row="true" Breakpoint="Breakpoint.Xs" Spacing="2" Class="dashboard-action-buttons">
                    <MudButton OnClick="OpenWebsite" Variant="Variant.Outlined" Disabled="_saving">View Website</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving">@(_saving ? "Saving…" : "Save changes")</MudButton>
                </MudStack>
            </div>
        </EditForm>
    </MudPaper>
}


@code {
    private FooterEditModel? _model;
    private readonly EditorSnapshot _snapshot = new();
    private string[] CurrentValues => _model is null ? [] : [System.Text.Json.JsonSerializer.Serialize(_model)];
    private bool IsDirty => _model is not null && _snapshot.HasChanges(CurrentValues);
    private bool _saving, _saved;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try { _model = await GlobalSettings.GetFooterForEditAsync(); _snapshot.Capture(CurrentValues); }
        catch (Exception exception) when (Expected(exception))
        {
            Logger.LogError(exception, "Unable to load Footer.");
            _error = "Content could not be loaded. Check your session and refresh; defaults are not shown as saved content.";
        }
    }
    private void ClearSaved() => _saved = false;
    private void OpenWebsite() => Navigation.NavigateTo("/", forceLoad: true);
    private async Task SaveAsync()
    {
        if (_saving || _model is null) return;
        _saving = true; _saved = false; _error = null;
        try
        {
            await GlobalSettings.SaveFooterAsync(_model);
            _snapshot.Capture(CurrentValues); _saved = true;
        }
        catch (Exception exception) when (Expected(exception))
        {
            Logger.LogError(exception, "Unable to save Footer.");
            _error = "Content could not be saved. Your changes are retained. Check your session and try again.";
        }
        finally { _saving = false; }
    }
    private static bool Expected(Exception exception) => exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException or IOException or InvalidOperationException;
}
