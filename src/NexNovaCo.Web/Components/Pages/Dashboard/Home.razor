@page "/dashboard"

<PageTitle>Dashboard | NexNovaCo</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Dashboard</MudText>
<AuthorizeView Roles="Admin">
    <Authorized Context="auth">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6">Welcome, @auth.User.Identity?.Name</MudText>
            <MudText Class="mt-2">Your secure Dashboard foundation is ready. Content editing is not available yet.</MudText>
        </MudPaper>
    </Authorized>
</AuthorizeView>
