@page "/dashboard/content/services/home-featured"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IServiceContentService ServicesService
@inject NavigationManager Navigation
@inject ILogger<HomeFeaturedServicesEditor> Logger

<PageTitle>Home Featured Services | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Shared Content / Services</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Home Featured Services</MudText>
<MudText Class="dashboard-muted mb-5">Select up to five shared Services for Home's existing two-row layout, then set their Home order. Changes apply only after Save. The full Services page order and Home introduction are separate.</MudText>
<UnsavedChangesGuard IsDirty="IsDirty" />
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert> }
@if (_saved) { <MudAlert Severity="Severity.Success" Class="mb-4" role="status">Home Featured selection and order saved.</MudAlert> }
@if (_items is not null)
{
    <div class="featured-editor">
    <MudPaper Class="dashboard-editor mb-5" Outlined="true" Elevation="0">
        <section class="dashboard-editor-section" aria-labelledby="available-services-heading">
            <MudText Typo="Typo.h6" HtmlTag="h2" id="available-services-heading">Available Services</MudText>
            <MudText Class="dashboard-muted mb-4">@_selected.Count / @HomeFeaturedServiceRules.MaximumCount selected. Uncheck a Service to make room. An empty selection hides the Home section.</MudText>
            @if (_items.Count == 0) { <MudText>No Services yet. Add a Service from All Services first.</MudText> }
            @foreach (var item in _items)
            {
                <MudCheckBox @key="item.Id" T="bool" Value="@_selected.Contains(item.Id)" ValueChanged="@((bool value) => Toggle(item.Id, value))"
                    Label="@item.Name" Disabled="@(_saving || (!_selected.Contains(item.Id) && _selected.Count >= HomeFeaturedServiceRules.MaximumCount))" />
            }
        </section>
    </MudPaper>
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Featured order</MudText>
    <MudTable T="ServiceListItem" Items="SelectedItems" Hover="true" Outlined="true" Elevation="0" Breakpoint="Breakpoint.Md" Class="featured-table mb-5">
        <HeaderContent><MudTh>Home order</MudTh><MudTh>Icon</MudTh><MudTh>Name</MudTh><MudTh>Actions</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Home order">@(_selected.IndexOf(context.Id) + 1)</MudTd>
            <MudTd DataLabel="Icon"><ServiceIconPreview IconPath="@context.IconPath" Name="@context.Name" /></MudTd>
            <MudTd DataLabel="Name"><span class="featured-name">@context.Name</span></MudTd>
            <MudTd DataLabel="Actions"><div class="featured-actions">
                <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" aria-label="@($"Move up featured {context.Name}")" Disabled="@(_saving || context.Id == _selected[0])" OnClick="@(() => Move(context.Id, -1))" />
                <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" aria-label="@($"Move down featured {context.Name}")" Disabled="@(_saving || context.Id == _selected[^1])" OnClick="@(() => Move(context.Id, 1))" />
                <MudIconButton Icon="@Icons.Material.Outlined.Close" aria-label="@($"Remove featured {context.Name}")" Disabled="_saving" OnClick="@(() => Toggle(context.Id, false))" />
            </div></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No featured Services selected. Save to keep Home's Services section hidden.</MudText></NoRecordsContent>
    </MudTable>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Disabled="_saving">@(_saved ? "Back to All Services" : "Cancel")</MudButton>
        <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving">@(_saving ? "Saving…" : "Save featured selection")</MudButton>
    </MudStack>
    </div>
}
else { <MudButton Href="/dashboard/content/services">Back to All Services</MudButton> }

@code {
    private IReadOnlyList<ServiceListItem>? _items;
    private List<int> _selected = [];
    private readonly EditorSnapshot _snapshot = new();
    private string[] CurrentValues => _selected.Select(id => id.ToString(System.Globalization.CultureInfo.InvariantCulture)).ToArray();
    private bool IsDirty => _items is not null && _snapshot.HasChanges(CurrentValues);
    private IEnumerable<ServiceListItem> SelectedItems => _selected.Select(id => _items!.Single(item => item.Id == id));
    private bool _saving;
    private bool _saved;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await ServicesService.ListAsync();
            _selected = _items.Where(x => x.HomeDisplayOrder is not null).OrderBy(x => x.HomeDisplayOrder).ThenBy(x => x.Id).Select(x => x.Id).ToList();
            _snapshot.Capture(CurrentValues);
        }
        catch (Exception exception) when (IsExpected(exception))
        {
            Logger.LogError(exception, "Unable to load Home Featured Services.");
            _error = "The selection could not be loaded. Check your session and return to All Services to retry.";
        }
    }
    private void Toggle(int id, bool selected)
    {
        if (_saving || _items?.Any(x => x.Id == id) != true) return;
        _saved = false;
        if (!selected) _selected.Remove(id);
        else if (!_selected.Contains(id) && _selected.Count < HomeFeaturedServiceRules.MaximumCount) _selected.Add(id);
    }
    private void Move(int id, int direction)
    {
        if (_saving) return;
        var index = _selected.IndexOf(id);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= _selected.Count) return;
        (_selected[index], _selected[target]) = (_selected[target], _selected[index]);
        _saved = false;
    }
    private void Cancel() => Navigation.NavigateTo("/dashboard/content/services");
    private async Task SaveAsync()
    {
        if (_saving || _items is null) return;
        _saving = true; _saved = false; _error = null;
        try
        {
            await ServicesService.SaveHomeFeaturedAsync(_selected);
            _snapshot.Capture(CurrentValues);
            _saved = true;
        }
        catch (Exception exception) when (IsExpected(exception))
        {
            Logger.LogError(exception, "Unable to save Home Featured Services.");
            _error = "Selection could not be saved. Your choices are retained. A Service may have been deleted; return to All Services and reopen this editor to reload.";
        }
        finally { _saving = false; }
    }
    private static bool IsExpected(Exception exception) => exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException;
}
