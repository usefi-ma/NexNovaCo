@page "/dashboard/content/home/projects"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IHomeProjectsSectionContentService ProjectsService
@inject ILogger<HomeProjectsSectionEditor> Logger
@inject NavigationManager Navigation

<PageTitle>Projects Section | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Home / Projects</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Projects Section</MudText>
<MudText Class="dashboard-muted mb-7">Manage the heading and introduction shown above the project cards on the homepage.</MudText>
<UnsavedChangesGuard IsDirty="IsDirty" />
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert>
}
@if (_saved)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" role="status">Home Projects section updated successfully.</MudAlert>
}
@if (_model is not null)
{
    <MudPaper Class="dashboard-editor" Elevation="0" Outlined="true">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="ClearSaved" FormName="home-projects">
            <DataAnnotationsValidator />
            <section class="dashboard-editor-section" aria-labelledby="projects-content-heading">
                <MudText Typo="Typo.h6" HtmlTag="h2" id="projects-content-heading">Content</MudText>
                <MudText Typo="Typo.body2" Class="dashboard-muted mb-6">Only the section title and description are editable. Project cards remain managed by the canonical catalog.</MudText>
                <MudGrid Spacing="4">
                    <MudItem xs="12"><MudTextField @bind-Value="_model.Title" For="@(() => _model.Title)" Label="Title" Variant="Variant.Outlined" MaxLength="120" Immediate="true" Disabled="_saving" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Description" HelperText="Up to 1,000 characters. Keep the copy concise for the existing public layout." Variant="Variant.Outlined" MaxLength="1000" Lines="5" Sizing="InputSizing.Auto" Immediate="true" Disabled="_saving" /></MudItem>
                </MudGrid>
            </section>
            <MudDivider />
            <div class="dashboard-editor-actions">
                <MudText Typo="Typo.caption" Class="dashboard-muted">Changes go live when saved. Project cards and design stay the same.</MudText>
                <MudStack Row="true" Breakpoint="Breakpoint.Xs" Spacing="2" Class="dashboard-action-buttons">
                    <MudButton OnClick="OpenHome" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.OpenInNew">View Home Page</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" DropShadow="false" Disabled="_saving">@(_saving ? "Saving…" : "Save changes")</MudButton>
                </MudStack>
            </div>
        </EditForm>
    </MudPaper>
}

@code {
    private HomeProjectsSectionEditModel? _model;
    private readonly EditorSnapshot _snapshot = new();
    private string[] CurrentValues => _model is null ? [] :
        [_model.Title, _model.Description];
    private bool IsDirty => _model is not null && _snapshot.HasChanges(CurrentValues);
    private string? _error;
    private bool _saving;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await ProjectsService.GetForEditAsync();
            _snapshot.Capture(CurrentValues);
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            Logger.LogError(exception, "Unable to load the Home Projects editor.");
            _error = "Home Projects could not be loaded. Refresh the page to try again, or contact the site administrator.";
        }
    }

    private void ClearSaved() => _saved = false;
    private void OpenHome() => Navigation.NavigateTo("/", forceLoad: true);

    private async Task SaveAsync()
    {
        if (_saving || _model is null) return;
        _saving = true;
        _saved = false;
        _error = null;
        try
        {
            await ProjectsService.UpdateAsync(_model);
            _snapshot.Capture(CurrentValues);
            _saved = true;
        }
        catch (Exception exception) when (IsExpectedFailure(exception))
        {
            Logger.LogError(exception, "Unable to save Home Projects content.");
            _error = "Home Projects could not be saved. Your changes are still in this form. Check your session and try again.";
        }
        finally { _saving = false; }
    }

    private static bool IsExpectedFailure(Exception exception) =>
        exception is DbException or DbUpdateException or KeyNotFoundException or UnauthorizedAccessException or ValidationException;
}
