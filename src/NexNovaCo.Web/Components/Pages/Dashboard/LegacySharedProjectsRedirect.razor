@page "/dashboard/content/projects/new"
@page "/dashboard/content/projects/{Id:int}"
@page "/dashboard/content/projects/home-featured"
@inject NavigationManager Navigation
@code {
    [Parameter] public int? Id { get; set; }
    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var suffix = Id is int id ? id.ToString(System.Globalization.CultureInfo.InvariantCulture) : path.EndsWith("/new", StringComparison.OrdinalIgnoreCase) ? "new" : "home-featured";
        Navigation.NavigateTo("/dashboard/content/shared-projects/" + suffix, replace: true);
    }
}
