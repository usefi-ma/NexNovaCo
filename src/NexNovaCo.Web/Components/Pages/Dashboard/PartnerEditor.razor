@page "/dashboard/content/partners/new"
@page "/dashboard/content/partners/{Id:int}"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IPartnerContentService PartnersService
@inject ILogger<PartnerEditor> Logger
@inject NavigationManager Navigation

<PageTitle>@(_editingId is null ? "Add" : "Edit") Partner | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Shared Content / Partners</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">@(_editingId is null ? "Add partner" : "Edit partner")</MudText>
<MudText Class="dashboard-muted mb-7">Saved changes appear in the shared Home and About carousel. Keep the copy concise for the existing public layout.</MudText>
<UnsavedChangesGuard IsDirty="IsDirty" />
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert> }
@if (_saved) { <MudAlert Severity="Severity.Success" Class="mb-4" role="status">Partner saved for Home and About.</MudAlert> }
@if (_model is not null)
{
    <MudPaper Class="dashboard-editor" Elevation="0" Outlined="true">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="ClearSaved" FormName="shared-partner">
            <DataAnnotationsValidator />
            <section class="dashboard-editor-section" aria-labelledby="partner-content-heading">
                <MudText Typo="Typo.h6" HtmlTag="h2" id="partner-content-heading" Class="mb-5">Partner content</MudText>
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Name" HelperText="Required. Up to 80 characters." Variant="Variant.Outlined" MaxLength="80" Immediate="true" Disabled="_saving" Class="mb-6" />
                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Description" HelperText="Required. Plain text; up to 200 characters." Variant="Variant.Outlined" MaxLength="200" Lines="3" Immediate="true" Disabled="_saving" Class="mb-6" />
                <MudSelect T="string" @bind-Value="_model.ImagePath" For="@(() => _model.ImagePath)" Label="Logo path" HelperText="Choose an existing bundled logo. Uploads and custom paths are not available." Variant="Variant.Outlined" Disabled="_saving" Class="mb-4">
                    @foreach (var path in PartnerLogoAssets.Paths)
                    {
                        <MudSelectItem T="string" Value="@path">@path</MudSelectItem>
                    }
                </MudSelect>
                <PartnerLogoPreview ImagePath="@_model.ImagePath" Name="@_model.Name" HasLogoBackground="_model.HasLogoBackground" />
                <MudCheckBox T="bool" @bind-Value="_model.HasLogoBackground" Label="White logo background" Disabled="_saving" Class="mb-6" />
                <MudTextField @bind-Value="_model.Href" For="@(() => _model.Href)" Label="Link (optional)" HelperText="A public site route (e.g. /services) or an HTTPS URL. Leave empty for an unlinked logo." Variant="Variant.Outlined" MaxLength="500" Immediate="true" Disabled="_saving" />
            </section>
            <MudDivider />
            <div class="dashboard-editor-actions">
                <MudText Typo="Typo.caption" Class="dashboard-muted">This changes shared content, not Home's section introduction.</MudText>
                <MudStack Row="true" Breakpoint="Breakpoint.Xs" Spacing="2" Class="dashboard-action-buttons">
                    <MudButton OnClick="Cancel" Variant="Variant.Outlined" Disabled="_saving">@(_saved ? "Back to list" : "Cancel")</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving">@(_saving ? "Saving…" : "Save partner")</MudButton>
                </MudStack>
            </div>
        </EditForm>
    </MudPaper>
}
else
{
    <MudButton Href="/dashboard/content/partners" Variant="Variant.Outlined">Back to list</MudButton>
}

@code {
    [Parameter] public int? Id { get; set; }
    private int? _editingId;
    private PartnerEditModel? _model;
    private readonly EditorSnapshot _snapshot = new();
    private string[] CurrentValues => _model is null ? [] : [_model.Name, _model.Description, _model.ImagePath, _model.HasLogoBackground.ToString(), _model.Href ?? ""];
    private bool IsDirty => _model is not null && _snapshot.HasChanges(CurrentValues);
    private bool _saving;
    private bool _saved;
    private string? _error;
    private string? _navigateAfterSave;
    private bool _showCreated;

    protected override async Task OnParametersSetAsync()
    {
        _editingId = Id;
        _model = null;
        _error = null;
        _saved = _showCreated;
        _showCreated = false;
        try
        {
            _model = Id is int id ? await PartnersService.GetForEditAsync(id) : new PartnerEditModel();
            _snapshot.Capture(CurrentValues);
        }
        catch (Exception exception) when (IsExpected(exception))
        {
            Logger.LogError(exception, "Unable to load partner editor.");
            _error = exception is KeyNotFoundException ? "This partner no longer exists. Return to the list."
                : "The partner could not be loaded. Check your session and try again.";
        }
    }
    private void ClearSaved() => _saved = false;
    private void Cancel() => Navigation.NavigateTo("/dashboard/content/partners");
    private async Task SaveAsync()
    {
        if (_saving || _model is null) return;
        _saving = true;
        _saved = false;
        _error = null;
        try
        {
            if (_editingId is int id) await PartnersService.UpdateAsync(id, _model);
            else _editingId = await PartnersService.CreateAsync(_model);
            _snapshot.Capture(CurrentValues);
            _saved = true;
            // Leave /new after creation so refresh cannot accidentally create a duplicate.
            if (Id is null)
            {
                _showCreated = true;
                _navigateAfterSave = $"/dashboard/content/partners/{_editingId}";
            }
        }
        catch (Exception exception) when (IsExpected(exception))
        {
            Logger.LogError(exception, "Unable to save partner.");
            _error = exception is KeyNotFoundException or DbUpdateConcurrencyException
                ? "This partner changed or no longer exists. Your input is retained; return to the list to reload."
                : "The partner could not be saved. Your input is retained. Check your session and try again.";
        }
        finally { _saving = false; }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (_navigateAfterSave is not { } target) return;
        _navigateAfterSave = null;
        // The clean snapshot has now reached NavigationLock before leaving the /new route.
        Navigation.NavigateTo(target, replace: true);
    }
    private static bool IsExpected(Exception exception) => exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException;
}
