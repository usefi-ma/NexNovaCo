@page "/dashboard/content/projects/overview"
<PageTitle>Projects Section | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Projects / Projects Section</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Projects Section</MudText>
<MudPaper Class="dashboard-editor pa-6" Elevation="0" Outlined="true">
    <MudText Class="mb-5">This section displays the shared Project catalog. There is no separate page-specific introduction to edit. The decorative pagination is presentation-only. Manage cards and their order in Shared Content → Projects; those changes also apply wherever the shared cards are used.</MudText>
    <MudButton Href="/dashboard/content/shared-projects" Variant="Variant.Filled" Color="Color.Primary">Manage shared Projects</MudButton>
    <MudButton Href="/projects" Variant="Variant.Outlined" Class="ml-2 mt-2">View Projects Page</MudButton>
</MudPaper>
