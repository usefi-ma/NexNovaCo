@page "/dashboard/content/projects/testimonials"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IProjectsPageCmsService ProjectsPageService
@inject NavigationManager Navigation
@inject ILogger<ProjectsTestimonialsEditor> Logger

<PageTitle>Projects Testimonials Section | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Projects / Testimonials Section</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Projects Testimonials Section</MudText>
<MudText Class="dashboard-muted mb-7">Edit the brand title and description beside the shared testimonials. Quote content and ordering are managed in Shared Content → Testimonials.</MudText>
<UnsavedChangesGuard IsDirty="IsDirty" />
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error</MudAlert> }
@if (_saved) { <MudAlert Severity="Severity.Success" role="status" Class="mb-4">Projects Testimonials Section saved.</MudAlert> }
@if (_model is not null)
{
    <MudPaper Class="dashboard-editor" Elevation="0" Outlined="true">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="ClearSaved" FormName="projects-testimonials">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <section class="dashboard-editor-section" aria-label="Testimonials content">
                <MudTextField @bind-Value="_model.Title" For="@(() => _model.Title)" Label="Title" HelperText="Required. Up to 120 characters." Variant="Variant.Outlined" MaxLength="120" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Description" HelperText="Required. Up to 1000 characters." Variant="Variant.Outlined" MaxLength="1000" Lines="4" Sizing="InputSizing.Auto" Immediate="true" Disabled="_saving" Class="mb-5" />
            </section>
            <MudDivider />
            <div class="dashboard-editor-actions">
                <MudText Typo="Typo.caption" Class="dashboard-muted">Changes go live on Projects when saved. Layout and styling stay the same.</MudText>
                <MudStack Row="true" Breakpoint="Breakpoint.Xs" Spacing="2" Class="dashboard-action-buttons">
                    <MudButton OnClick="OpenProjects" Variant="Variant.Outlined" Disabled="_saving">View Projects Page</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving">@(_saving ? "Saving…" : "Save changes")</MudButton>
                </MudStack>
            </div>
        </EditForm>
    </MudPaper>
}


<MudPaper Class="dashboard-editor pa-6 mt-6" Elevation="0" Outlined="true">
    <MudText Class="mb-4">These settings affect Projects only. Client quotes remain shared with other pages.</MudText>
    <MudButton Href="/dashboard/content/testimonials" Variant="Variant.Outlined" Color="Color.Primary">Manage shared Testimonials</MudButton>
</MudPaper>

@code {
    private ProjectsTestimonialsEditModel? _model;
    private readonly EditorSnapshot _snapshot = new();
    private string[] CurrentValues => _model is null ? [] : [System.Text.Json.JsonSerializer.Serialize(_model)];
    private bool IsDirty => _model is not null && (_snapshot.HasChanges(CurrentValues));
    private bool _saving, _saved;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try { _model = await ProjectsPageService.GetTestimonialsForEditAsync(); _snapshot.Capture(CurrentValues); }
        catch (Exception exception) when (Expected(exception))
        {
            Logger.LogError(exception, "Unable to load Projects Testimonials Section.");
            _error = "Content could not be loaded. Check your session and refresh; defaults are not shown as saved content.";
        }
    }
    private void ClearSaved() => _saved = false;
    private void OpenProjects() => Navigation.NavigateTo("/projects", forceLoad: true);
    private async Task SaveAsync()
    {
        if (_saving || _model is null) return;
        _saving = true; _saved = false; _error = null;
        try
        {
            await ProjectsPageService.SaveTestimonialsAsync(_model);
            _snapshot.Capture(CurrentValues); _saved = true;
        }
        catch (Exception exception) when (Expected(exception))
        {
            Logger.LogError(exception, "Unable to save Projects Testimonials Section.");
            _error = "Content could not be saved. Your changes are retained. Check your session and try again.";
        }
        finally { _saving = false; }
    }
    private static bool Expected(Exception exception) => exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException or IOException;
}
