@page "/dashboard/content/services/overview"
<PageTitle>Services Section | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Services / Services Section</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Services Section</MudText>
<MudPaper Class="dashboard-editor pa-6" Elevation="0" Outlined="true">
    <MudText Class="mb-5">This section displays the shared Service catalog. There is no separate page-specific introduction to edit. Manage cards and their order in Shared Content → Services; those changes also apply wherever the shared cards are used.</MudText>
    <MudButton Href="/dashboard/content/shared-services" Variant="Variant.Filled" Color="Color.Primary">Manage shared Services</MudButton>
    <MudButton Href="/services" Variant="Variant.Outlined" Class="ml-2 mt-2">View Services Page</MudButton>
</MudPaper>
