@page "/dashboard/content/shop/hero"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IShopContentService ShopContent
@inject NavigationManager Navigation
@inject ILogger<ShopHeroEditor> Logger

<PageTitle>Shop Hero | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Shop / Hero</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Shop Hero</MudText>
<MudText Class="dashboard-muted mb-7">Edit the Shop introduction and hero photograph. The CTA always scrolls safely to Products.</MudText>
<UnsavedChangesGuard IsDirty="IsDirty" />
@if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error</MudAlert> }
@if (_saved) { <MudAlert Severity="Severity.Success" role="status" Class="mb-4">Shop Hero saved.</MudAlert> }
@if (_model is not null)
{
    <MudPaper Class="dashboard-editor" Elevation="0" Outlined="true">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" OnInvalidSubmit="ClearSaved" FormName="shop-hero">
            <DataAnnotationsValidator /><ValidationSummary />
            <section class="dashboard-editor-section" aria-label="Hero content">
                <MudTextField @bind-Value="_model.Eyebrow" For="@(() => _model.Eyebrow)" Label="Eyebrow" HelperText="Required. Up to 80 characters." Variant="Variant.Outlined" MaxLength="80" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.Title" For="@(() => _model.Title)" Label="Title" HelperText="Required. Up to 120 characters." Variant="Variant.Outlined" MaxLength="120" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Description" HelperText="Required. Up to 600 characters." Variant="Variant.Outlined" MaxLength="600" Lines="4" Sizing="InputSizing.Auto" Immediate="true" Disabled="_saving" Class="mb-5" />
                <MudTextField @bind-Value="_model.CtaLabel" For="@(() => _model.CtaLabel)" Label="CTA text" HelperText="Scrolls to the Products section." Variant="Variant.Outlined" MaxLength="60" Immediate="true" Disabled="_saving" Class="mb-5" />
                <CmsImageField @ref="_imageField" @bind-Value="_model.ImagePath" Kind="MediaKind.ShopHero" Label="Hero image" Hint="JPG, PNG or WebP up to 5 MB. Keep the left side calm enough for text." Disabled="_saving" Changed="ClearSaved" />
            </section>
            <MudDivider />
            <div class="dashboard-editor-actions">
                <MudText Typo="Typo.caption" Class="dashboard-muted">Changes go live on Shop when saved.</MudText>
                <MudStack Row="true" Breakpoint="Breakpoint.Xs" Spacing="2" Class="dashboard-action-buttons">
                    <MudButton OnClick="OpenShop" Variant="Variant.Outlined" Disabled="_saving">View Shop</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving">@(_saving ? "Saving…" : "Save changes")</MudButton>
                </MudStack>
            </div>
        </EditForm>
    </MudPaper>
}

@code {
    private ShopHeroEditModel? _model;
    private CmsImageField? _imageField;
    private readonly EditorSnapshot _snapshot = new();
    private string[] CurrentValues => _model is null ? [] : [System.Text.Json.JsonSerializer.Serialize(_model)];
    private bool IsDirty => _model is not null && (_snapshot.HasChanges(CurrentValues) || _imageField?.HasPendingSelection == true);
    private bool _saving, _saved;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try { _model = await ShopContent.GetHeroForEditAsync(); _snapshot.Capture(CurrentValues); }
        catch (Exception exception) when (Expected(exception)) { Logger.LogError(exception, "Unable to load Shop Hero."); _error = "Content could not be loaded. Check your session and refresh."; }
    }
    private void ClearSaved() => _saved = false;
    private void OpenShop() => Navigation.NavigateTo("/shop", forceLoad: true);
    private async Task SaveAsync()
    {
        if (_saving || _model is null) return;
        _saving = true; _saved = false; _error = null;
        var previousImagePath = _model.ImagePath;
        try
        {
            if (_imageField is not null) _model.ImagePath = await _imageField.CommitAsync();
            await ShopContent.SaveHeroAsync(_model); _imageField?.AcceptSaved(); _snapshot.Capture(CurrentValues); _saved = true;
        }
        catch (Exception exception) when (Expected(exception))
        {
            _model.ImagePath = previousImagePath; Logger.LogError(exception, "Unable to save Shop Hero.");
            _error = "Content could not be saved. Your changes are retained. Check your session and try again.";
        }
        finally { _saving = false; }
    }
    private static bool Expected(Exception exception) => exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException or IOException;
}
