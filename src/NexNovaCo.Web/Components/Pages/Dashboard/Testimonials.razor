@page "/dashboard/content/testimonials"
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject ITestimonialContentService TestimonialsService
@inject IDialogService Dialogs
@inject ILogger<Testimonials> Logger

<PageTitle>Shared Testimonials | NexNovaCo Dashboard</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<MudText Typo="Typo.overline" Class="dashboard-eyebrow">Shared Content / Testimonials</MudText>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Testimonials</MudText>
<MudText Class="dashboard-muted mb-5">Manage the same quotes and authors shown on Home and Projects. Home's brand-panel text is edited separately under Home → Testimonials Section.</MudText>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert> }
@if (_message is not null) { <MudAlert Severity="Severity.Success" Class="mb-4" role="status">@_message</MudAlert> }
<MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-5" Spacing="2">
    <MudButton Href="/dashboard/content/testimonials/new" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Add" DropShadow="false" Disabled="_busy">Add testimonial</MudButton>
    <MudButton OnClick="ReloadAsync" Variant="Variant.Outlined" Disabled="_busy">Refresh list</MudButton>
</MudStack>
<MudText Typo="Typo.body2" Class="dashboard-muted mb-4">Move up/down saves immediately on both pages. There is no separate ordering Save step.</MudText>
@if (_items is not null)
{
    <div class="testimonials-list">
    <MudTable T="TestimonialListItem" Items="_items" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Md" Class="testimonials-table" Loading="_busy">
        <HeaderContent>
            <MudTh>Order</MudTh><MudTh>Author / role / company</MudTh><MudTh>Quote preview</MudTh><MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
            <MudTd DataLabel="Author / role / company"><span class="testimonial-cell-text">@context.Attribution</span></MudTd>
            <MudTd DataLabel="Quote preview"><span class="testimonial-cell-text">@Preview(context.Quote)</span></MudTd>
            <MudTd DataLabel="Actions">
                <div class="testimonial-actions">
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" aria-label="@($"Move up {context.Attribution}")" Disabled="@(_busy || context.Id == _items[0].Id)" OnClick="@(() => MoveAsync(context.Id, -1))" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" aria-label="@($"Move down {context.Attribution}")" Disabled="@(_busy || context.Id == _items[^1].Id)" OnClick="@(() => MoveAsync(context.Id, 1))" />
                    <MudIconButton Href="@($"/dashboard/content/testimonials/{context.Id}")" Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" aria-label="@($"Edit {context.Attribution}")" Disabled="_busy" />
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" aria-label="@($"Delete {context.Attribution}")" Disabled="_busy" OnClick="@(() => DeleteAsync(context))" />
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No testimonials yet. Add one to show it on Home and Projects.</MudText></NoRecordsContent>
    </MudTable>
    </div>
}

@code {
    private IReadOnlyList<TestimonialListItem>? _items;
    private bool _busy;
    private string? _error;
    private string? _message;
    protected override Task OnInitializedAsync() => ReloadAsync();
    private static string Preview(string quote) => quote.Length <= 140 ? quote : quote[..140] + "…";
    private Task ReloadAsync() => RunAsync(async () => { _items = await TestimonialsService.ListAsync(); }, null);
    private Task MoveAsync(int id, int direction) => RunAsync(async () =>
    {
        var ids = _items!.Select(item => item.Id).ToList();
        var index = ids.IndexOf(id);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= ids.Count) return;
        (ids[index], ids[target]) = (ids[target], ids[index]);
        await TestimonialsService.ReorderAsync(ids);
        _items = await TestimonialsService.ListAsync();
    }, "Testimonial order saved for Home and Projects.");

    private async Task DeleteAsync(TestimonialListItem item)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var parameters = new DialogParameters<DeleteTestimonialDialog>
            {
                { dialog => dialog.Attribution, item.Attribution }, { dialog => dialog.IsLast, _items?.Count == 1 }
            };
            var dialog = await Dialogs.ShowAsync<DeleteTestimonialDialog>("Delete testimonial?", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true });
            var result = await dialog.Result;
            if (result?.Canceled != false) return;
            _busy = false;
            await RunAsync(async () =>
            {
                await TestimonialsService.DeleteAsync(item.Id);
                _items = await TestimonialsService.ListAsync();
            }, "Testimonial deleted from Home and Projects.");
        }
        finally { _busy = false; }
    }

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _message = null;
        try { await action(); _message = success; }
        catch (Exception exception) when (exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException)
        {
            Logger.LogError(exception, "Unable to complete testimonial management operation.");
            _error = exception is KeyNotFoundException or ValidationException or DbUpdateConcurrencyException
                ? "The collection changed or an item no longer exists. Refresh the list and try again."
                : "The operation could not be completed. Check your session, refresh the list, and try again.";
        }
        finally { _busy = false; }
    }
}
