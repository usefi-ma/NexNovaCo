@page "/"

@inject IWebHostEnvironment Environment
@inject IHomeContentService ContentService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>NexNovaCo | Smart Software, Powerful AI</PageTitle>
<HeadContent>
    <meta name="description" content="Explore NexNovaCo's software development and AI services, project portfolio, and team." />
    @* Original Home rules are route-local and unchanged. Only lifecycle adaptations follow. *@
    <link rel="stylesheet" href="@Assets["css/index.css"]" />
    <link rel="stylesheet" href="@Assets["css/carousel-blazor.css"]" />
    <link rel="stylesheet" href="@Assets["css/project-card-blazor.css"]" />
    <link rel="stylesheet" href="@Assets["css/testimonials-blazor.css"]" />
    <link rel="stylesheet" href="@Assets["css/home-blazor.css"]" />
</HeadContent>

@if (_content is not null)
{
    <div class="home-page" @ref="_root">
        <HomeHero Content="_content.Hero" />
        <HomeWelcomeSection Content="_content.Welcome" />
        @if (_content.Services.Count > 0)
        {
            <HomeServicesSection Heading="_content.ServicesHeading" Items="_content.Services" />
        }
        @if (_content.Projects.Count > 0)
        {
            <HomeProjectsSection Heading="_content.ProjectsHeading" Items="_content.Projects" />
        }
        <HomeTeamSection Content="_content.Team" Members="_content.Members" />
        <HomeStatisticsSection Items="_content.Statistics" />
        @if (_content.Partners.Count > 0)
        {
            <PartnersSection Heading="_content.PartnersHeading" Items="_content.Partners" />
        }
        @if (_content.Testimonials.Count > 0)
        {
            <TestimonialsSection Items="_content.Testimonials" Brand="_content.TestimonialBrand" />
        }
    </div>
    @if (Environment.IsDevelopment() && Verification == "foundation")
    {
        <div class="container py-5"><FoundationDiagnostics /></div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "verify")] public string? Verification { get; set; }
    private HomeContent? _content;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _initialized;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        try { _content = await ContentService.GetAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_content is null || _initialized || _disposed) return;
        _initialized = true;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/home.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }
        _module = module;
        await _module.InvokeVoidAsync("initialize", _root);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        // Browser-side MutationObserver owns DOM/plugin cleanup, including lost circuits.
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
