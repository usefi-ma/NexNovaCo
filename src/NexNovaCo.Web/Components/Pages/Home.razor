@page "/"

@inject IWebHostEnvironment Environment

@* Phase 1 migration placeholder. Full Home content requires Phase 2 approval. *@
<PageTitle>Home | NexNovaCo</PageTitle>
<section class="container migration-placeholder">
    <h1>Home</h1>
    <p>Page content will be migrated in a later phase.</p>
    @if (Environment.IsDevelopment() && Verification == "foundation")
    {
        <FoundationDiagnostics />
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "verify")] public string? Verification { get; set; }
}
