@page "/projects/{Slug}"
@inject IProjectCatalog ProjectCatalog
@inject IDetailTemplateContentService Templates
@inject NavigationManager Navigation
@implements IDisposable

<PublicPageHead Path="@("/projects/" + _project?.Summary.Slug)" Title="@(_project?.Summary.Name ?? "Project")"
                Description="@_project?.Summary.Description" ImagePath="@_project?.Summary.ImagePath"
                ParentPath="/projects" ParentLabel="@_template.BreadcrumbSectionLabel" BreadcrumbHomeLabel="@_template.BreadcrumbHomeLabel" IsContentAvailable="@(_project is not null)">
    <link rel="stylesheet" href="@Assets["css/inner-project.css"]" />
    <link rel="stylesheet" href="@Assets["css/inner-page-blazor.css"]" />
    <link rel="stylesheet" href="@Assets["css/project-detail-blazor.css"]" />
</PublicPageHead>

@if (_project is not null)
{
    @* Remount gallery/reveals when only the route parameter changes. *@
    <ProjectDetailContent Content="_project" Template="_template" @key="_project.Summary.Slug" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Models.ProjectDetail? _project;
    private ProjectDetailTemplateEditModel _template = ProjectDetailTemplateEditModel.Approved();
    private readonly CancellationTokenSource _lifetime = new();
    private int _request;

    protected override async Task OnParametersSetAsync()
    {
        var request = ++_request;
        _project = null;
        try
        {
            var project = await ProjectCatalog.GetDetailAsync(Slug, _lifetime.Token);
            var template = await Templates.ReadProjectAsync(_lifetime.Token);
            if (request != _request || _lifetime.IsCancellationRequested) return;
            _project = project;
            _template = template;
            if (project is null) Navigation.NotFound();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
