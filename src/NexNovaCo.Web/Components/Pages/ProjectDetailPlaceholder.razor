@page "/projects/{Slug}"
@inject IProjectCatalog ProjectCatalog
@inject NavigationManager Navigation

@* Navigation-only placeholder. Full Project Detail migration is explicitly deferred. *@
<PageTitle>@(_project?.Name ?? "Project") | NexNovaCo</PageTitle>
<section class="container migration-placeholder">
    <h1>@_project?.Name</h1>
    <p>This project detail page has not been migrated yet.</p>
    <a class="custome_btn" href="projects">Back to projects</a>
</section>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private ProjectSummary? _project;
    protected override async Task OnParametersSetAsync()
    {
        _project = (await ProjectCatalog.GetAsync()).FirstOrDefault(p => p.Slug == Slug);
        if (_project is null) Navigation.NotFound();
    }
}
