@page "/shop"
@inject IShopContentService ContentService
@inject NavigationManager Navigation

<PublicPageHead Path="/shop" Title="Shop" Description="@_content?.Hero.Description" ImagePath="@_content?.Hero.ImagePath">
    <link rel="stylesheet" href="@Assets["css/shop.css"]" />
    <link rel="stylesheet" href="@Assets["css/inner-page-blazor.css"]" />
</PublicPageHead>

@if (_content is not null)
{
    <div class="shop-page" style="@($"--shop-hero-image: url('{Navigation.ToAbsoluteUri(_content.Hero.ImagePath)}')")">
        <InnerPageHero Content="@HeroContent" />

        <section class="shop-products" id="products" aria-labelledby="shop-products-title">
            <div class="shop-container">
                <header class="shop-products__header">
                    <div>
                        <p class="shop-eyebrow">@_content.ProductsSection.Eyebrow</p>
                        <h2 id="shop-products-title">@_content.ProductsSection.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(_content.ProductsSection.Introduction))
                        {
                            <p class="shop-products__intro">@_content.ProductsSection.Introduction</p>
                        }
                    </div>
                    @if (_content.Products.Count > 0)
                    {
                        <p class="shop-products__count">All Products (@_content.Products.Count)</p>
                    }
                </header>

                @if (_content.Products.Count == 0)
                {
                    <div class="shop-empty" role="status">
                        <h3>Products are coming soon.</h3>
                        <p>Our digital collection is being prepared. Please check back later.</p>
                    </div>
                }
                else
                {
                    <div class="shop-product-grid">
                        @foreach (var product in _content.Products)
                        {
                            <ProductCard Content="product" />
                        }
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private ShopContent? _content;
    private InnerPageHeroContent HeroContent => new(
        _content!.Hero.Title,
        _content.Hero.Title,
        _content.Hero.Description,
        _content.Hero.CtaLabel,
        "/shop#products");

    protected override async Task OnInitializedAsync() => _content = await ContentService.ReadPublicAsync();
}
