@inject NavigationManager Navigation
<section class="head" style="--cms-hero-image: url('@Navigation.ToAbsoluteUri(Content.ImagePath)')" aria-label="Introduction">
    <div class="head_cover" aria-hidden="true"></div>
    <div class="head_right" aria-hidden="true">
        <div class="hexagon_1" data-aos="fade-down"></div>
        <div class="hexagon_2" data-aos="fade-down-left"></div>
    </div>
    <div class="hexagon_3" aria-hidden="true"></div>
    <div class="hexagon_4" data-aos="zoom-in" aria-hidden="true"></div>
    <div class="hexagon_5" data-aos="fade-up-right">
        <div class="script">
            <h1>
                <span class="font_500" data-aos="fade-up-right" data-aos-delay="0" data-aos-duration="600">@Content.OpeningLine</span>
                <span class="font_900" data-aos="fade-up-right" data-aos-delay="100" data-aos-duration="600">@Content.EmphasisLine</span>
                <span class="font_600" data-aos="fade-up-right" data-aos-delay="200" data-aos-duration="600">@Content.ClosingLine</span>
            </h1>
            <hr data-aos="fade-up-right" data-aos-delay="300" data-aos-duration="600" />
            <p data-aos="fade-up-right" data-aos-delay="400" data-aos-duration="600">@Content.Description</p>
            <a class="custome_btn" data-aos="fade-up-right" data-aos-delay="500" data-aos-duration="600" href="@Content.CtaHref">@Content.CtaLabel</a>
        </div>
    </div>
    <div class="hexagon_6" aria-hidden="true"></div>
    <div class="hexagon_7" data-aos="fade-down" aria-hidden="true"></div>
</section>

@code {
    [Parameter, EditorRequired] public HomeHeroContent Content { get; set; } = default!;
}
