<section class="service" aria-label="@Heading.Title">
    <div class="container-fluid">
        <div class="row service_container">
            <div class="col-12 col-xl-12 col-xxl-9 service_bg">
                <div class="row service_row_first">
                    @for (var i = 0; i < Math.Min(2, Items.Count); i++)
                    {
                        <div class="col-12 col-sm-6 col-md-5 col-lg-4 col-xxl-4 col-xxxl-3" data-aos="fade-up" data-aos-delay="@(i * 100)">
                            <ServiceCard Content="Items[i]" />
                        </div>
                    }
                </div>
                <div class="row service_row_second">
                    @for (var i = 2; i < Items.Count; i++)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-3 col-xxl-3 @(i == Items.Count - 1 ? "service_last" : null)" data-aos="fade-up" data-aos-delay="@(i * 100)">
                            <ServiceCard Content="Items[i]" />
                        </div>
                    }
                </div>
            </div>
            <div class="col-12 col-md-10 col-lg-10 col-xl-10 col-xxl-3">
                <div class="service_content">
                    <h3 data-aos="zoom-out" data-aos-delay="0">@Heading.Title</h3>
                    <p data-aos="zoom-out" data-aos-delay="100">@Heading.Description</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SectionHeading Heading { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ServiceSummary> Items { get; set; } = default!;
}
