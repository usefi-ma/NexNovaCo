<section class="counter" data-aos="fade-zoom-out" aria-label="NexNovaCo in numbers">
    <div class="counter_container">
        <div class="opacity_div">
            <div class="container">
                <div class="row">
                    @foreach (var item in Items)
                    {
                        <div class="col-12 col-sm-6 col-lg-3"><StatisticItem Content="item" /></div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Statistic> Items { get; set; } = default!;
}
