<div class="container">
    <div class="row team_member">
        @for (var i = 0; i < Items.Count; i++)
        {
            <div class="col-12 col-md-6 mb-5" data-aos="fade-up" data-aos-delay="@(i * 100)">
                <TeamMemberCard Content="Items[i]" Context="TeamMemberCardContext.Listing" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TeamMemberSummary> Items { get; set; } = default!;
}
