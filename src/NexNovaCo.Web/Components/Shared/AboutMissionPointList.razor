@using NexNovaCo.Web.Data
@using System.ComponentModel.DataAnnotations
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@inject IAboutCmsService AboutService
@inject IDialogService Dialogs
@inject ILogger<AboutMissionPointList> Logger

<section class="mt-8" aria-label="Mission commitments">
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">Mission commitments</MudText>
    <MudText Class="dashboard-muted mb-4">Move up/down saves immediately. Deleting every item keeps this list empty until you add another.</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_error</MudAlert> }
    @if (_message is not null) { <MudAlert Severity="Severity.Success" role="status" Class="mb-4">@_message</MudAlert> }
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
        <MudButton Href="/dashboard/content/about/mission/points/new" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Add commitment</MudButton>
        <MudButton OnClick="ReloadAsync" Variant="Variant.Outlined" Disabled="_busy">Refresh list</MudButton>
    </MudStack>
    @if (_items is not null)
    {
        <MudTable T="AboutMissionPointItem" Items="_items" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Md" Loading="_busy" Class="about-cms-table">
            <HeaderContent><MudTh>Order</MudTh><MudTh>Description</MudTh><MudTh>Actions</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                <MudTd DataLabel="Description"><span style="overflow-wrap:anywhere">@context.Description</span></MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" aria-label="@($"Move up commitment {context.DisplayOrder}")" Disabled="@(_busy || context.Id == _items[0].Id)" OnClick="@(() => MoveAsync(context.Id, -1))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" aria-label="@($"Move down commitment {context.DisplayOrder}")" Disabled="@(_busy || context.Id == _items[^1].Id)" OnClick="@(() => MoveAsync(context.Id, 1))" />
                        <MudIconButton Href="@($"/dashboard/content/about/mission/points/{context.Id}")" Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" aria-label="@($"Edit commitment {context.DisplayOrder}")" Disabled="_busy" />
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" aria-label="@($"Delete commitment {context.DisplayOrder}")" Disabled="_busy" OnClick="@(() => DeleteAsync(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>No commitments yet. Add one to show it on About.</MudText></NoRecordsContent>
        </MudTable>
    }
</section>
@code {
    private IReadOnlyList<AboutMissionPointItem>? _items;
    private bool _busy;
    private string? _error, _message;
    protected override Task OnInitializedAsync() => ReloadAsync();
    private Task ReloadAsync() => RunAsync(async () => { _items = await AboutService.ListMissionPointAsync(); }, null);
    private Task MoveAsync(int id, int direction) => RunAsync(async () =>
    {
        var ids = _items!.Select(x => x.Id).ToList();
        var index = ids.IndexOf(id); var target = index + direction;
        if (index < 0 || target < 0 || target >= ids.Count) return;
        (ids[index], ids[target]) = (ids[target], ids[index]);
        await AboutService.ReorderMissionPointAsync(ids); _items = await AboutService.ListMissionPointAsync();
    }, "Mission commitments order saved.");
    private async Task DeleteAsync(AboutMissionPointItem item)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<DeleteAboutItemDialog>("Delete commitment?",
                new DialogParameters<DeleteAboutItemDialog> { { x => x.Name, item.Description } },
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true });
            var result = await dialog.Result;
            if (result?.Canceled != false) return;
            _busy = false;
            await RunAsync(async () => { await AboutService.DeleteMissionPointAsync(item.Id); _items = await AboutService.ListMissionPointAsync(); }, "commitment deleted.");
        }
        finally { _busy = false; }
    }
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null;
        try { await action(); _message = success; }
        catch (Exception exception) when (exception is DbException or DbUpdateException or ValidationException or KeyNotFoundException or UnauthorizedAccessException)
        {
            Logger.LogError(exception, "About commitment operation failed.");
            _error = "The operation could not be completed. Check your session, refresh the list and try again.";
        }
        finally { _busy = false; }
    }
}
