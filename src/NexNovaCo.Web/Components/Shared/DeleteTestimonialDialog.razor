<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudText>Delete the testimonial from @Attribution?</MudText>
        <MudText Class="dashboard-muted mt-3">It will be removed from both Home and Projects. This cannot be undone.</MudText>
        @if (IsLast)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">This is the last testimonial. Both public sections will be hidden while empty. The next controlled application startup initializes an empty collection with the approved defaults.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton OnClick="Delete" Color="Color.Error" Variant="Variant.Filled" DropShadow="false">Delete testimonial</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Attribution { get; set; } = "";
    [Parameter] public bool IsLast { get; set; }
    private void Cancel() => Dialog.Cancel();
    private void Delete() => Dialog.Close(DialogResult.Ok(true));
}
