<div class="product-image-preview">
    @if (!_failed && MediaPolicy.IsAllowed(ImagePath, MediaKind.Product))
    {
        <img @key="ImagePath" src="@ImagePath" alt="@(Name + " cover")" width="72" height="54" @onerror="() => _failed = true" />
    }
    else
    {
        <span role="img" aria-label="Image unavailable">No image</span>
    }
</div>

@code {
    [Parameter] public string ImagePath { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    private string? _previousPath;
    private bool _failed;
    protected override void OnParametersSet()
    {
        if (_previousPath == ImagePath) return;
        _previousPath = ImagePath;
        _failed = false;
    }
}
