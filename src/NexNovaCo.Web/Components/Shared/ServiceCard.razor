<div class="service_box">
    <div class="service_box_icon">
        <div class="hexagon"><img src="@Content.IconPath" alt="@Content.Name" loading="lazy" /></div>
    </div>
    <div class="service_box_content">
        <h3>@Content.Name</h3>
        <h4>@Content.Tagline</h4>
        <p>@Content.Description</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ServiceSummary Content { get; set; } = default!;
}
