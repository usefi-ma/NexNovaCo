<div class="team_member_box">
    <div class="team_member_header">
        <div class="team_back horizental_hexagon">
            <a href="@Content.ProfileHref"><img class="team-image" src="@Content.ImagePath" alt="@Content.Name" loading="lazy" /></a>
        </div>
    </div>
    <div class="team_member_desc">
        <h3><a href="@Content.ProfileHref">@Content.Name</a></h3>
        <h4>@Content.Role</h4>
        <p>@Content.Introduction</p>
        <SocialLinks Name="@Content.Name" Email="@Content.Email" LinkedIn="@Content.LinkedIn" Telegram="@Content.Telegram" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TeamMemberSummary Content { get; set; } = default!;
}
