<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>NexNovaCo-Web-Development-Identity</UserSecretsId>
    <!-- Keep symbols in build output for debugging, not in the deployable directory. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="[9.10.0]" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="[10.0.12]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[10.0.12]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.12]" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve migration references locally; no Blazor component loads these scripts. -->
    <Content Update="wwwroot/js/jquery-3.1.0.js" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/js/script.js;wwwroot/js/inner-project.js;wwwroot/js/member.js;wwwroot/js/contact.js;wwwroot/js/bootstrap.min.js;wwwroot/js/aos.js"
             CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="wwwroot/uploads/**" />
    <None Remove="wwwroot/uploads/**" />
    <!-- Runtime Identity data is private, never a build/publish asset. -->
    <Content Remove="App_Data/**;**/*.db;**/*.db-shm;**/*.db-wal;**/*.db-journal" />
    <None Remove="App_Data/**;**/*.db;**/*.db-shm;**/*.db-wal;**/*.db-journal" />
  </ItemGroup>

</Project>
